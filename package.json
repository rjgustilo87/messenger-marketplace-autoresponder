{
  "name": "messenger-autoresponder",
  "version": "1.1.0",
  "description": "Facebook Messenger autoresponder for Marketplace messages - with Stagehand fallback",
  "main": "main.js",
  "scripts": {
    "build": "node --check main.js && node --check inquiry-replies.js && node --check test-dom.js && node --check scripts/check-setup.js",
    "check-setup": "node scripts/check-setup.js",
    "test": "node --test test/*.test.js",
    "start": "node main.js",
    "dev": "node --inspect main.js",
    "test-dom": "node test-dom.js",
    "install-deps": "npx playwright install-deps chromium",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "facebook",
    "messenger",
    "marketplace",
    "autoresponder",
    "automation",
    "stagehand"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.41.0",
    "@browserbasehq/stagehand": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
